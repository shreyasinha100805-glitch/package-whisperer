# Package Whisperer - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# DO NOT commit your actual .env file with real secrets to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Ring API Configuration (Track Tool)
RING_CLIENT_ID=your_ring_client_id_here
RING_CLIENT_SECRET=your_ring_client_secret_here
RING_HMAC_KEY=your_hmac_webhook_verification_secret_here

# Amazon Web Services / Amazon Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
