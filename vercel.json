{
  "version": 2,
  "rewrites": [
    {
      "source": "/landing",
      "destination": "/index.html"
    },
    {
      "source": "/caretaker",
      "destination": "/index.html"
    },
    {
      "source": "/resident",
      "destination": "/index.html"
    },
    {
      "source": "/simulator",
      "destination": "/index.html"
    },
    {
      "source": "/architecture",
      "destination": "/index.html"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/webhook",
      "destination": "/api/index.js"
    },
    {
      "source": "/token",
      "destination": "/api/index.js"
    },
    {
      "source": "/link",
      "destination": "/api/index.js"
    },
    {
      "source": "/styles.css",
      "destination": "/css/styles.css"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  }
}
